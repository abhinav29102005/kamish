# Kamish Dashboard Frontend Configuration Example
# Copy to .env.local to configure local settings.

# Gateway Base URL
# - In same-origin reverse proxy deployments (recommended production topology),
#   leave this empty so requests route to /api and /metrics on the same origin.
# - In separate-origin deployments, set to the full Gateway URL (e.g. https://gateway.internal:3001)
# - In local development with Vite dev server (port 5173), defaults to http://127.0.0.1:3001
VITE_KAMISH_GATEWAY_URL=

# Development Login Helper
# Set to true to show quick preset credentials in development/demo environments.
# Defaults to true in Vite dev mode, false in production builds.
VITE_ENABLE_DEV_LOGIN=false
