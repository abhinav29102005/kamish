{
  "scenario_name": "three_region_evidence",
  "version": "1.0.0",
  "seed": 42,
  "runs": 5,
  "topology": {
    "regions": ["EU_WEST", "US_EAST", "AP_SOUTH"],
    "in_region_replication": {
      "ensemble_size": 3,
      "write_quorum": 3,
      "ack_quorum": 2,
      "durability_contract": "INV-2/INV-3 (2-of-3 persist ACK)"
    },
    "wan_links": [
      {
        "from": "EU_WEST",
        "to": "US_EAST",
        "configured_latency_ms": 70.0,
        "configured_jitter_ms": 5.0,
        "loss_rate": 0.0
      },
      {
        "from": "EU_WEST",
        "to": "AP_SOUTH",
        "configured_latency_ms": 130.0,
        "configured_jitter_ms": 10.0,
        "loss_rate": 0.0
      },
      {
        "from": "US_EAST",
        "to": "AP_SOUTH",
        "configured_latency_ms": 190.0,
        "configured_jitter_ms": 15.0,
        "loss_rate": 0.0
      }
    ]
  },
  "routing": {
    "ewma_alpha": 0.2,
    "circuit_breaker": {
      "failure_threshold": 3,
      "reset_timeout_ms": 2000,
      "half_open_success_threshold": 2
    },
    "retry_policy": {
      "initial_backoff_ms": 50,
      "multiplier": 2.0,
      "max_backoff_ms": 1000,
      "max_retries": 3
    }
