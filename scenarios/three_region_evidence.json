    "lease_ttl_ms": 10000,
    "produce_path_consensus_reads": 0
  },
  "invariants": [
    "INV-1: Linearizable epoch monotonically increasing, strictly non-regressing",
    "INV-2: In-region quorum replication requires >=2 physical persists before ACK",
    "INV-3: Zero silent uncommitted record loss on leader crash or failover",
    "INV-4: StrictLocal and BorderRestricted residency strictly enforced before wire egress",
    "INV-5: Common-prefix reconciliation quarantines superseded uncommitted divergent records",
    "INV-6: Independent history cross-reference verifies 0 loss, 0 dupes, 0 ordering gaps",
    "INV-7: Storage and wire canary scanning detects zero canary token leakage"
  ]
}
